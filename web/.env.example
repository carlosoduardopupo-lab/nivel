# Copia este archivo a .env.local con los datos de tu app web de Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps).
# En local (npm run dev) se usan los emuladores y estos valores no hacen falta.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Pon "true" para usar los emuladores también en un build de producción.
VITE_USAR_EMULADORES=
