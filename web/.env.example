# Normalmente NO hace falta: publicada en Firebase Hosting, la app lee su
# configuración de /__/firebase/init.json. Solo si la alojas en otro sitio,
# copia este archivo a .env.local con los datos de tu app web de Firebase
# (Consola de Firebase > Configuración del proyecto > Tus apps).
# En local (npm run dev) se usan los emuladores.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Pon "true" para usar los emuladores también en un build de producción.
VITE_USAR_EMULADORES=
