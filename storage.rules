rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function registrado() {
      return request.auth != null;
    }

    function publicacionEsperando(creadorId, postId) {
      let post = firestore.get(/databases/(default)/documents/posts/$(postId)).data;
      return post.creadorId == creadorId
        && post.estado == 'subiendo'
        && ((post.tipo == 'foto' && request.resource.contentType.matches('image/.*'))
            || (post.tipo == 'video' && request.resource.contentType.matches('video/.*')));
    }

    // Foto o video original: solo el creador o quien la desbloqueó.
    match /originales/{creadorId}/{postId} {
      allow read: if registrado() && (
        request.auth.uid == creadorId
        || firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/desbloqueos/$(postId))
      );
      // El creador sube una sola vez, después de crear la publicación con
      // crearPublicacion; no se puede reemplazar ni borrar desde el cliente.
      allow create: if registrado()
        && request.auth.uid == creadorId
        && resource == null
        && request.resource.size < 50 * 1024 * 1024
        && publicacionEsperando(creadorId, postId);
      allow update, delete: if false;
    }

    // Versión borrosa: pública para registrados; la genera Cloud Functions.
    match /borrosas/{archivo} {
      allow read: if registrado();
      allow write: if false;
    }

    // Reels: video público para registrados. El autor lo sube una vez tras crearReel.
    match /reels/{autorId}/{reelId} {
      allow read: if registrado();
      allow create: if registrado()
        && request.auth.uid == autorId
        && resource == null
        && request.resource.size < 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*')
        && firestore.get(/databases/(default)/documents/reels/$(reelId)).data.autorId == autorId
        && firestore.get(/databases/(default)/documents/reels/$(reelId)).data.estado == 'subiendo';
      allow update, delete: if false;
    }

    match /portadas-reels/{archivo} {
      allow read: if registrado();
      allow write: if false;
    }

    match /avatares/{archivo} {
      allow read: if registrado();
      allow write: if registrado()
        && archivo == request.auth.uid + '.jpg'
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /{todo=**} {
      allow read, write: if false;
    }
  }
}
