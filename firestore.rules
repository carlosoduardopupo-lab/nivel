rules_version = '2';

// Regla general: el cliente casi no escribe nada. Monedas, vidas, ganancias,
// desbloqueos, progreso, intentos, contadores, preguntas y reportes se
// escriben SOLO desde Cloud Functions (Admin SDK, que ignora estas reglas).
service cloud.firestore {
  match /databases/{database}/documents {

    function registrado() {
      return request.auth != null;
    }

    function esYo(uid) {
      return registrado() && request.auth.uid == uid;
    }

    function desbloqueo(postId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/desbloqueos/$(postId));
    }

    // ---------- Perfil público ----------
    match /users/{uid} {
      allow read: if registrado();
      // El dueño solo puede cambiar su avatar y sus intereses.
      allow update: if esYo(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarUrl', 'intereses'])
        && (!('intereses' in request.resource.data)
            || (request.resource.data.intereses is list && request.resource.data.intereses.size() <= 10))
        && (!('avatarUrl' in request.resource.data)
            || request.resource.data.avatarUrl == null
            || request.resource.data.avatarUrl is string);
      allow create, delete: if false;

      match /desbloqueos/{postId} {
        allow read: if esYo(uid);
        allow write: if false;
      }
      match /progreso/{creadorId} {
        allow read: if esYo(uid);
        allow write: if false;
      }
      match /intentos/{postId} {
        allow read: if esYo(uid);
        allow write: if false;
      }
      match /siguiendo/{creadorId} {
        allow read: if registrado();
        allow write: if false;
      }
      // Usuarios que bloqueé: solo los veo yo; los escribe Functions (bloquear).
      match /bloqueados/{otroId} {
        allow read: if esYo(uid);
        allow write: if false;
      }
    }

    match /usernames/{nombre} {
      allow read, write: if false;
    }

    // ---------- Datos privados ----------
    match /private/{uid} {
      allow read: if esYo(uid);
      allow write: if false;

      match /ganancias/{id} {
        allow read: if esYo(uid);
        allow write: if false;
      }
      // Avisos de la campana: los lee el dueño; los escribe Functions.
      match /notificaciones/{id} {
        allow read: if esYo(uid);
        allow write: if false;
      }
      // Tokens de push: solo Functions.
      match /dispositivos/{token} {
        allow read, write: if false;
      }
    }

    // ---------- Estadísticas de uso: solo los administradores (también en web/src/util.ts) ----------
    match /estadisticas/{dia} {
      allow read: if registrado() && request.auth.uid in ['y4KUHbYPChSM2QFa7VMoAyX3a952'];
      allow write: if false;
    }

    // ---------- Reels (gratis; los escribe solo Functions) ----------
    match /reels/{reelId} {
      // Las consultas deben filtrar estado == 'publicado' (o autorId == yo).
      allow read: if registrado() && (resource.data.estado == 'publicado' || resource.data.autorId == request.auth.uid);
      allow write: if false;

      match /meGusta/{likerUid} {
        allow read: if registrado();
        allow write: if false;
      }

      // Los comentarios de los reels son públicos para registrados.
      match /comentarios/{id} {
        allow read: if registrado();
        allow write: if false;
      }
    }

    // ---------- Publicaciones ----------
    match /posts/{postId} {
      // Las consultas del feed deben filtrar estado == 'aprobada' y oculta == false.
      allow read: if registrado() && (
        resource.data.creadorId == request.auth.uid
        || (resource.data.estado == 'aprobada' && resource.data.oculta == false)
        // Quien la desbloqueó la conserva aunque el creador la elimine.
        || exists(/databases/$(database)/documents/users/$(request.auth.uid)/desbloqueos/$(postId))
      );
      allow write: if false;

      match /preguntas/{n} {
        allow read, write: if false;
      }

      match /meGusta/{likerUid} {
        allow read: if registrado();
        allow write: if false;
      }

      match /comentarios/{id} {
        allow read: if registrado() && (
          desbloqueo(postId)
          || get(/databases/$(database)/documents/posts/$(postId)).data.creadorId == request.auth.uid
        );
        allow write: if false;
      }
    }

    // ---------- Dinero y moderación ----------
    match /reportes/{id} {
      allow read, write: if false;
    }

    match /compras/{id} {
      allow read: if registrado() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /retiros/{id} {
      allow read: if registrado() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    // Todo lo no listado queda cerrado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
